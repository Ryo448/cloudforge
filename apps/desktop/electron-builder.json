{
  "appId": "app.cloudforge.desktop",
  "productName": "Cloudforge",
  "npmRebuild": false,
  "publish": null,
  "directories": { "app": "apps/desktop", "output": "release" },
  "files": ["dist/**/*", "electron/**/*", "package.json"],
  "extraResources": [
    { "from": "dist/core", "to": ".", "filter": ["cloudforge-core*"] },
    { "from": "apps/web/dist", "to": "web" },
    { "from": "assets/icon/icon.png", "to": "icon.png" },
    { "from": "dist/dbeaver", "to": "dbeaver", "filter": ["runtime.tar.gz"] },
    { "from": "third_party/dbeaver", "to": "dbeaver/source" },
    {
      "from": "node_modules/@fontsource/ibm-plex-sans/files",
      "to": "dbeaver/fonts",
      "filter": [
        "ibm-plex-sans-latin-400-normal.woff2",
        "ibm-plex-sans-latin-500-normal.woff2",
        "ibm-plex-sans-latin-600-normal.woff2"
      ]
    },
    {
      "from": "node_modules/@fontsource/ibm-plex-mono/files",
      "to": "dbeaver/fonts",
      "filter": ["ibm-plex-mono-latin-400-normal.woff2"]
    },
    { "from": "LICENSE", "to": "LICENSE" }
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon/icon.ico",
    "extraResources": [
      {
        "from": "dist/cloudflared",
        "to": "cloudflared",
        "filter": ["cloudflared.exe", "LICENSE"]
      }
    ]
  },
  "linux": { "target": "AppImage", "category": "Development" },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "assets/icon/icon.ico",
    "uninstallerIcon": "assets/icon/icon.ico"
  }
}
